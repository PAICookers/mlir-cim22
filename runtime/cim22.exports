      llvm::StringError::ID;
      /* The native board-runner test links this shared runtime directly. */
      cim22::runtime::CIMBoardRunner::*;
      "vtable for cim22::runtime::CIMBoardRunner";
      "typeinfo for cim22::runtime::CIMBoardRunner";
      "typeinfo name for cim22::runtime::CIMBoardRunner";
    };
  local: *;
};
