// RUN: %python %S/../../python/ONNX/generate_conv_integer_onnx.py --emit-dir %t.first | FileCheck %s --check-prefix=GENERATE
// RUN: %python %S/../../python/ONNX/generate_conv_integer_onnx.py --emit-dir %t.second
// RUN: cmp %t.first/canonical.onnx %t.second/canonical.onnx
// RUN: cmp %t.first/odd.onnx %t.second/odd.onnx
// RUN: cmp %t.first/pointwise.onnx %t.second/pointwise.onnx
// RUN: cmp %t.first/rectangular.onnx %t.second/rectangular.onnx
// RUN: mlir-cim22-onnx-import %t.first/canonical.onnx | FileCheck %s --check-prefix=CANONICAL
// RUN: mlir-cim22-onnx-import %t.first/odd.onnx | FileCheck %s --check-prefix=ODD
// RUN: mlir-cim22-onnx-import %t.first/pointwise.onnx | FileCheck %s --check-prefix=POINTWISE
// RUN: mlir-cim22-onnx-import %t.first/rectangular.onnx | FileCheck %s --check-prefix=RECTANGULAR

// GENERATE: PASS ConvInteger ONNX generation: canonical, odd-work, pointwise, and rectangular

// CANONICAL-LABEL: func.func @main(%{{.*}}: tensor<1x8x8x8xi8>) -> tensor<1x19x8x8xi32>
// CANONICAL: tensor.pad %{{.*}} low[0, 0, 1, 1] high[0, 0, 1, 1]
// CANONICAL: arith.constant dense<{{.*}}> : tensor<19x8x3x3xi8>
// CANONICAL: linalg.conv_2d_nchw_fchw {{.*}}cim.onnx.conv_integer{{.*}}
// CANONICAL-NOT: f32
// CANONICAL: return %{{.*}} : tensor<1x19x8x8xi32>

// ODD-LABEL: func.func @main(%{{.*}}: tensor<1x1x3x3xi8>) -> tensor<1x1x3x3xi32>
// ODD: tensor.pad %{{.*}} low[0, 0, 1, 1] high[0, 0, 1, 1]
// ODD: linalg.conv_2d_nchw_fchw {{.*}}cim.onnx.conv_integer{{.*}}
// ODD: return %{{.*}} : tensor<1x1x3x3xi32>

// POINTWISE-LABEL: func.func @main(%{{.*}}: tensor<1x3x5x7xi8>) -> tensor<1x5x3x4xi32>
// POINTWISE-NOT: tensor.pad
// POINTWISE: arith.constant dense<{{.*}}> : tensor<5x3x1x1xi8>
// POINTWISE: linalg.conv_2d_nchw_fchw {{.*}}cim.onnx.conv_integer{{.*}}strides = dense<2>
// POINTWISE: return %{{.*}} : tensor<1x5x3x4xi32>

// RECTANGULAR-LABEL: func.func @main(%{{.*}}: tensor<1x2x5x6xi8>) -> tensor<1x17x3x3xi32>
// RECTANGULAR: tensor.pad %{{.*}} low[0, 0, 1, 0] high[0, 0, 0, 1]
// RECTANGULAR: arith.constant dense<{{.*}}> : tensor<17x2x2x3xi8>
// RECTANGULAR: linalg.conv_2d_nchw_fchw {{.*}}cim.onnx.conv_integer{{.*}}strides = dense<2>
// RECTANGULAR: return %{{.*}} : tensor<1x17x3x3xi32>
