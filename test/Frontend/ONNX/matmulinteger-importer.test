// RUN: mlir-cim22-onnx-import %S/../../Inputs/ONNX/int8_matmulinteger_model.onnx | grep -E 'func.func|linalg.transpose|linalg.matmul|return' | FileCheck %s --check-prefix=IMPORT

// IMPORT: func.func @main({{.*}}: tensor<32x512xi8>) -> tensor<32x1024xi32>
// IMPORT: linalg.transpose ins({{.*}} : tensor<32x512xi8>) outs({{.*}} : tensor<512x32xi8>) permutation = [1, 0]
// IMPORT: linalg.matmul {cim.onnx.matmul_integer} ins({{.*}} : tensor<1024x512xi8>, tensor<512x32xi8>) outs({{.*}} : tensor<1024x32xi32>) -> tensor<1024x32xi32>
// IMPORT: linalg.transpose ins({{.*}} : tensor<1024x32xi32>) outs({{.*}} : tensor<32x1024xi32>) permutation = [1, 0]
// IMPORT: return {{.*}} : tensor<32x1024xi32>
