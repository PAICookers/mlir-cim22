@LIT_SITE_CFG_IN_HEADER@

config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")
config.mlir_c_runner_utils = lit_config.substitute(
    "@LLVM_LIBRARY_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@mlir_c_runner_utils@CMAKE_SHARED_LIBRARY_SUFFIX@"
)
config.mlir_cim22_obj_root = "@MLIRCIM22_BINARY_DIR@"
config.python_executable = lit_config.substitute("@Python3_EXECUTABLE@")
config.python_version = "@Python3_VERSION@"
config.cim22_runtime = "@LLVM_LIBRARY_OUTPUT_INTDIR@/@CMAKE_SHARED_LIBRARY_PREFIX@cim22_runtime@CMAKE_SHARED_LIBRARY_SUFFIX@"

import lit.llvm

lit.llvm.initialize(lit_config, config)
lit_config.load_config(config, "@MLIRCIM22_SOURCE_DIR@/test/lit.cfg.py")
