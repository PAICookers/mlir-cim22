// RUN: %python %S/../../python/ONNX/generate_rtl_artifact_onnx.py --heterogeneous --batch 2 --output %t.models/rtl-artifact-heterogeneous.onnx
// RUN: mlir-cim22-onnx-import %t.models/rtl-artifact-heterogeneous.onnx | mlir-cim22-opt --pass-pipeline='builtin.module(fold-cim-int8-bias,partition-cim-program,form-cim-program,func.func(materialize-cim-schedule,map-cim-schedule),materialize-cim-execution-plan,materialize-cim-static-weight-section,lower-cimframe-commands-to-packets,verify-cimframe)' -o %t.heterogeneous.packet
// RUN: not mlir-cim22-opt %t.heterogeneous.packet --export-cim-rtl-artifacts='output-dir=%t.heterogeneous.artifacts input-cache-file=%S/../../Inputs/CIM22/test_data_1_17_macro1/cache_in_int8.txt' 2>&1 | FileCheck %s --check-prefix=HETEROGENEOUS
// RUN: mlir-cim22-opt %t.packet --export-cim-rtl-artifacts='output-dir=%t.artifacts-copy input-cache-file=%S/../../Inputs/CIM22/test_data_1_17_macro1/cache_in_int8.txt' -o /dev/null
// RUN: diff -r %t.artifacts %t.artifacts-copy
// RUN: not mlir-cim22-opt %t.packet --export-cim-rtl-artifacts 2>&1 | FileCheck %s --check-prefix=MISSING
// RUN: not mlir-cim22-opt %t.packet --export-cim-rtl-artifacts='output-dir=%t.artifacts input-cache-file=%S/../../Inputs/CIM22/test_data_1_17_macro1/cache_in_int8.txt' 2>&1 | FileCheck %s --check-prefix=EXISTS

// MISSING: export-cim-rtl-artifacts requires output-dir
// EXISTS: RTL artifact output directory already exists
// HETEROGENEOUS: multicast source mode cannot represent different weights for one Macro
