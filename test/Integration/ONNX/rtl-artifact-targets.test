// Exercise a row boundary and all five response-index bits independently of
// the default four-core demo. Recipients must match the mapping, not a box.
// RUN: %python %S/../../python/ONNX/generate_rtl_artifact_onnx.py --batch 12 --output %t.models/six.onnx
// RUN: mlir-cim22-onnx-import %t.models/six.onnx | mlir-cim22-opt --pass-pipeline='builtin.module(fold-cim-int8-bias,partition-cim-program,form-cim-program,func.func(materialize-cim-schedule,map-cim-schedule),materialize-cim-execution-plan,materialize-cim-static-weight-section,lower-cimframe-commands-to-packets,verify-cimframe)' -o %t.six.packet
// RUN: rm -rf %t.six.artifacts %t.twenty.artifacts
// RUN: mlir-cim22-opt %t.six.packet --export-cim-rtl-artifacts='output-dir=%t.six.artifacts input-cache-file=%S/../../Inputs/CIM22/test_data_1_17_macro1/cache_in_int8.txt' -o /dev/null
// RUN: %python %S/../../python/CIM22/verify_rtl_artifacts.py %t.six.artifacts --cores 6
// RUN: %python %S/../../python/ONNX/generate_rtl_artifact_onnx.py --batch 40 --output %t.models/twenty.onnx
// RUN: mlir-cim22-onnx-import %t.models/twenty.onnx | mlir-cim22-opt --pass-pipeline='builtin.module(fold-cim-int8-bias,partition-cim-program,form-cim-program,func.func(materialize-cim-schedule,map-cim-schedule),materialize-cim-execution-plan,materialize-cim-static-weight-section,lower-cimframe-commands-to-packets,verify-cimframe)' -o %t.twenty.packet
// RUN: mlir-cim22-opt %t.twenty.packet --export-cim-rtl-artifacts='output-dir=%t.twenty.artifacts input-cache-file=%S/../../Inputs/CIM22/test_data_1_17_macro1/cache_in_int8.txt' -o /dev/null
// RUN: %python %S/../../python/CIM22/verify_rtl_artifacts.py %t.twenty.artifacts --cores 20
