// A single transaction uses cores 0-2 with two Macros, core 3 with Macro 0 only.
// Keep the fixed single-core numerical oracle; independently decode all targets.
// RUN: mlir-cim22-opt %S/Inputs/bf16-four-core.mlir --pass-pipeline='builtin.module(func.func(materialize-cim-schedule,map-cim-schedule),materialize-cim-execution-plan,materialize-cim-static-weight-section,lower-cimframe-commands-to-packets,verify-cimframe)' -o %t.packet
// RUN: rm -rf %t.artifacts
// RUN: mlir-cim22-opt %t.packet --export-cim-rtl-artifacts='bf16-reference=true output-dir=%t.artifacts input-cache-file=%S/Inputs/bf16-input-cache.txt' -o /dev/null
// RUN: %python %S/../../python/CIM22/verify_rtl_artifacts.py %t.artifacts --cores 4 --active-macros 0:0 0:1 1:0 1:1 2:0 2:1 3:0 --bf16
// RUN: %python %S/../../python/CIM22/bf16_reference_case.py verify %t.artifacts
// Seven recipients must not pass the old eight-Macro expectation.
// RUN: not %python %S/../../python/CIM22/verify_rtl_artifacts.py %t.artifacts --cores 4 --bf16 --check weights 2>&1 | FileCheck %s
// CHECK: CIM writes do not match active Macros
// Two Macro multicast sets of 397 flits each, plus four return routes.
// RUN: test $(wc -l < %t.artifacts/01_config.frames.txt) -eq 798
// One multicast start, then one clear; the board waits between them.
// RUN: test $(wc -l < %t.artifacts/02_work.frames.txt) -eq 2
// Macro 0 reads cores 0-3; Macro 1 reads cores 0-2. Ten flits per set.
// RUN: test $(wc -l < %t.artifacts/03_readback.frames.txt) -eq 20

