# Default deny: only reviewed build guides and implementation/test trees below
# enter Codebase Memory. This excludes local documents, models and metadata.
/*
!/CMakeLists.txt
!/README.md
!/BUILDING.md
!/cmake/
!/cmake/**
!/include/
!/include/**
!/lib/
!/lib/**
!/tools/
!/tools/**
!/test/
!/test/**
!/python/
!/python/**
!/schema/
!/schema/**
!/web/
!/web/**

# Generated bindings are checked against schema/cim22_model.proto by CMake.
/python/cim22/_generated/
