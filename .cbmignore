# Default deny: only the implementation, build, test and schema trees below
# enter Codebase Memory. This protects local documents, models and metadata.
/*
!/CMakeLists.txt
!/cmake/
!/cmake/**
!/include/
!/include/**
!/lib/
!/lib/**
!/tools/
!/tools/**
!/test/
!/test/**
!/python/
!/python/**
!/schema/
!/schema/**

# Generated bindings are checked against schema/cim22_model.proto by CMake.
/python/cim22/_generated/
