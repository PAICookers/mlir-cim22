# Default deny: only reviewed build guides and implementation/test trees below
# enter Codebase Memory. This excludes local documents, models and metadata.
/*
!/CMakeLists.txt
!/README.md
!/.github/
/.github/*
!/.github/scripts/
!/.github/scripts/**
!/docs/
/docs/*
!/docs/BUILDING.md
!/docs/BF16.md
!/cmake/
!/cmake/**
!/include/
!/include/**
!/lib/
!/lib/**
!/runtime/
!/runtime/**
!/tools/
/tools/*
!/tools/CMakeLists.txt
!/tools/mlir-cim22-compile/
!/tools/mlir-cim22-compile/**
!/tools/mlir-cim22-opt/
!/tools/mlir-cim22-opt/**
!/tools/mlir-cim22-onnx-import/
!/tools/mlir-cim22-onnx-import/**
!/test/
!/test/**
!/python/
!/python/**
!/schema/
!/schema/**
!/web/
!/web/**

# Generated bindings are checked against schema/cim22_model.proto by CMake.
/python/tests/_generated/
